{
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.42.1",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.42.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/sqlite3": "^3.1.11",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text-summary --forceExit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:growth": "node scripts/quality/check-file-growth.js",
    "quality": "tsc --noEmit && node scripts/quality/check-file-growth.js && jest --runInBand --forceExit",
    "release": "node scripts/build/release.js",
    "release:apk": "node scripts/build/release_apk.js",
    "sync": "node scripts/build/sync_clean.js"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".*\\.spec\\.js$"
    ]
  }
}
